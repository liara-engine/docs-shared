{
  "$schema": "https://liara-engine.github.io/liara/schemas/documentation-module.schema.json",
  "metadata": {
    "name": "MDBook Custom Theme",
    "description": "A custom theme for MDBook documentation, not deployed itself but used by each `book.toml` to generate the actual documentation for each module."
  },

  "resources": {
    "css": [
      "docs-shared/tokens/design-tokens.css",
      "docs-shared/navbar/navbar.css"
    ],
    "js": [
      "docs-shared/navbar/navbar.js",
      "docs-shared/navbar/navbar.config.js"
    ],
    "favicon-ico": "docs-shared/assets/favicon.ico",
    "favicon-svg": "docs-shared/assets/logo.svg"
  },

  "replacements": {
    "{{{NAVBAR}}}": {
      "is-file": true,
      "value": "docs-shared/navbar/navbar.html",
      "only-in-files": ["index.hbs"]
    },
    "{{{LOGO}}}": {
      "is-file": false,
      "value": "{{ resource \"favicon.svg\" }}",
      "only-in-files": ["index.hbs"]
    }
  }
}