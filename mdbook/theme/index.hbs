<!DOCTYPE HTML>

{{!--
    Liara Engine — mdBook template (index.hbs)

    This template replaces mdBook's default index.hbs to integrate the
    shared Liara navbar at the top of every user-guide page. It is based
    on mdBook's default template but reorganized so that:
        1. The Liara navbar appears at the very top of the body.
        2. The mdBook sidebar slides in below the navbar (not above it).
        3. Theme/a11y preferences are applied synchronously to prevent
           flash of unstyled content.

    Handlebars tokens (do not remove or rename):
        {{ language }}             current language code
        {{ title }}                page title
        {{ description }}          page description
        {{ path_to_root }}         relative path to the book root
        {{ chapter_title }}        chapter title for <title>
        {{ default_theme }}        configured default theme
        {{ preferred_dark_theme }} dark theme name
        {{ #toc }}{{ /toc }}       sidebar TOC content
        {{{ content }}}            the rendered chapter HTML
        {{ #if ... }}              conditional blocks for optional features
--}}

<html lang="{{ language }}" class="sidebar-visible no-js {{ default_theme }}">
<head>
<meta charset="UTF-8">
<title>{{ chapter_title }} - {{ book_title }}</title>
{{#if is_print }}
<meta name="robots" content="noindex">
{{/if}}
{{#if base_url}}
<base href="{{ base_url }}">
{{/if}}
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="#FFFAFC">

{{#if favicon_svg}}
<link rel="icon" href="{{ resource "favicon.svg" }}">
{{/if}}
{{#if favicon_png}}
<link rel="shortcut icon" href="{{ resource "favicon.png" }}">
{{/if}}
<link rel="stylesheet" href="{{ resource "css/variables.css" }}">
<link rel="stylesheet" href="{{ resource "css/general.css" }}">
<link rel="stylesheet" href="{{ resource "css/chrome.css" }}">
{{#if print_enable}}
<link rel="stylesheet" href="{{ resource "css/print.css" }}" media="print">
{{/if}}

<link rel="stylesheet" href="{{ resource "fonts/fonts.css" }}">

<link rel="stylesheet" id="mdbook-highlight-css" href="{{ resource "highlight.css" }}">
<link rel="stylesheet" id="mdbook-tomorrow-night-css" href="{{ resource "tomorrow-night.css" }}">
<link rel="stylesheet" id="mdbook-ayu-highlight-css" href="{{ resource "ayu-highlight.css" }}">

{{!-- Liara design system (loaded AFTER mdBook's own CSS so we override) --}}
<link rel="stylesheet" href="{{ path_to_root }}css/design-tokens.css">
<link rel="stylesheet" href="{{ path_to_root }}css/navbar.css">
<link rel="stylesheet" href="{{ path_to_root }}docs-shared/mdbook/additionals/css/custom.css">

{{#each additional_css}}
<link rel="stylesheet" href="{{ ../path_to_root }}{{ this }}">
{{/each}}

{{#if mathjax_support}}
<script async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-svg.js"></script>
{{/if}}
</head>
<body class="sidebar-visible">
{{!-- Provide site root and default themes for the JS to consume --}}
<div id="mdbook-body-container">

{{!-- Apply theme/a11y prefs synchronously, before mdBook's own theme JS runs --}}
<script>
(function () {
    try {
        var t = localStorage.getItem("liara-theme");
        if (t === "light" || t === "dark") {
            document.documentElement.setAttribute("data-liara-theme", t);
        }
        if (localStorage.getItem("liara-a11y-dyslexia") === "true") {
            document.documentElement.setAttribute("data-liara-a11y-dyslexia", "true");
        }
        // Bridge to mdBook's own theme system: align mdBook's `class` on <html>
        // with our chosen theme, so its native styles also follow.
        var mdbookTheme = (t === "dark") ? "{{ preferred_dark_theme }}"
                       : (t === "light") ? "{{ default_theme }}"
                       : null;
        if (mdbookTheme) {
            document.documentElement.classList.remove(
                "light", "rust", "coal", "navy", "ayu");
            document.documentElement.classList.add(mdbookTheme);
        }
    } catch (e) { /* localStorage unavailable, fall back to defaults */ }
})();
</script>

{{!-- ====================================================================
     LIARA NAVBAR — mirrors docs-shared/navbar/navbar.html
     ==================================================================== --}}
{{{NAVBAR}}}

<script src="{{ path_to_root }}js/navbar.config.js"></script>
{{!-- Load the Liara navbar logic AFTER the navbar markup is in the DOM --}}
<script defer src="{{ path_to_root }}js/navbar.js"></script>

{{!-- ====================================================================
     mdBook layout — sidebar + content
     ==================================================================== --}}

{{!-- Provide site root for the JS to consume --}}
<input type="hidden" id="MDBOOK_OUTPUT" value="{{ path_to_root }}">
{{#if mathjax_support}}<input type="hidden" id="MathJax_Support" value="true">{{/if}}

{{!-- Hide / unhide sidebar before it is displayed --}}
<script>
    var path_to_root = "{{ path_to_root }}";
    var default_theme = window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "{{ preferred_dark_theme }}" : "{{ default_theme }}";
</script>

{{!-- Set the theme before any content is loaded, prevents flash --}}
<script>
    try {
        var theme = localStorage.getItem('mdbook-theme');
        var sidebar = localStorage.getItem('mdbook-sidebar');

        if (theme.startsWith('"') && theme.endsWith('"')) {
            localStorage.setItem('mdbook-theme', theme.slice(1, theme.length - 1));
        }

        if (sidebar.startsWith('"') && sidebar.endsWith('"')) {
            localStorage.setItem('mdbook-sidebar', sidebar.slice(1, sidebar.length - 1));
        }
    } catch (e) { }
</script>

<input type="checkbox" id="mdbook-sidebar-toggle-anchor" class="hidden">

{{!-- Sidebar --}}
<nav id="mdbook-sidebar" class="sidebar" aria-label="Table of contents">
    <div class="sidebar-scrollbox">
        {{#toc}}{{/toc}}
    </div>
    <div id="mdbook-sidebar-resize-handle" class="sidebar-resize-handle">
        <div class="sidebar-resize-indicator"></div>
    </div>
</nav>

{{!-- Track and set sidebar scroll position --}}
<script>
    var sidebarScrollbox = document.querySelector('#mdbook-sidebar .sidebar-scrollbox');
    sidebarScrollbox.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') {
            sessionStorage.setItem('sidebar-scroll', sidebarScrollbox.scrollTop);
        }
    }, { passive: true });
    var sidebarScrollTop = sessionStorage.getItem('sidebar-scroll');
    sessionStorage.removeItem('sidebar-scroll');
    if (sidebarScrollTop) {
        sidebarScrollbox.scrollTop = sidebarScrollTop;
    } else {
        var activeSection = document.querySelector('#mdbook-sidebar .active');
        if (activeSection) {
            activeSection.scrollIntoView({ block: 'center' });
        }
    }
</script>

<div id="page-wrapper" class="page-wrapper">

    <div class="page">
        {{> header}}
        <div id="mdbook-menu-bar-hover-placeholder"></div>
        <div id="mdbook-menu-bar" class="menu-bar sticky">
            <div class="left-buttons">
                <label id="mdbook-sidebar-toggle" class="icon-button" for="mdbook-sidebar-toggle-anchor" title="Toggle Table of Contents" aria-label="Toggle Table of Contents" aria-controls="mdbook-sidebar">
                    {{fa "solid" "bars"}}
                </label>
                <button id="mdbook-theme-toggle" class="icon-button" type="button" title="Change theme" aria-label="Change theme" aria-haspopup="true" aria-expanded="false" aria-controls="mdbook-theme-list" style="display: none">
                    {{fa "solid" "paintbrush"}}
                </button>
                <ul id="mdbook-theme-list" class="theme-popup" aria-label="Themes" role="menu" style="display: none">
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-default_theme">Auto</button></li>
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-light">Light</button></li>
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-rust">Rust</button></li>
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-coal">Coal</button></li>
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-navy">Navy</button></li>
                    <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-ayu">Ayu</button></li>
                </ul>
                {{#if search_enabled}}
                <button id="mdbook-search-toggle" class="icon-button" type="button" title="Search (`/`)" aria-label="Toggle Searchbar" aria-expanded="false" aria-keyshortcuts="/ s" aria-controls="mdbook-searchbar">
                    {{fa "solid" "magnifying-glass"}}
                </button>
                {{/if}}
            </div>

            <h1 class="menu-title">{{ book_title }}</h1>

            <div class="right-buttons">
                {{#if git_repository_url}}
                <a href="{{git_repository_url}}" title="Git repository" aria-label="Git repository">
                    <i id="git-repository-button" class="fa {{git_repository_icon}}"></i>
                </a>
                {{/if}}
                {{#if git_repository_edit_url}}
                <a href="{{git_repository_edit_url}}" title="Suggest an edit" aria-label="Suggest an edit">
                    <i id="git-edit-button" class="fa fa-edit"></i>
                </a>
                {{/if}}
            </div>
        </div>

        {{#if search_enabled}}
        <div id="mdbook-search-wrapper" class="hidden">
            <form id="mdbook-searchbar-outer" class="searchbar-outer">
                <div class="search-wrapper">
                    <input type="search" id="mdbook-searchbar" name="searchbar" placeholder="Search this book ..." aria-controls="mdbook-searchresults-outer" aria-describedby="searchresults-header">
                    <div class="spinner-wrapper">
                        {{fa "solid" "spinner" "fa-spin"}}
                    </div>
                </div>
            </form>
            <div id="mdbook-searchresults-outer" class="searchresults-outer hidden">
                <div id="mdbook-searchresults-header" class="searchresults-header"></div>
                <ul id="mdbook-searchresults">
                </ul>
            </div>
        </div>
        {{/if}}

        {{!-- Apply ARIA attributes after the sidebar and the sidebar toggle button are added to the DOM --}}
        <script>
            document.getElementById('mdbook-sidebar-toggle-anchor').addEventListener('change', function () {
                document.getElementById('mdbook-sidebar-toggle').setAttribute('aria-expanded', this.checked.toString());
                document.getElementById('mdbook-sidebar').setAttribute('aria-hidden', (!this.checked).toString());
                Array.from(document.querySelectorAll('#mdbook-sidebar a')).forEach(function (link) {
                    link.setAttribute('tabIndex', this.checked ? 0 : -1);
                }.bind(this));
            });
        </script>

        <div id="content" class="content">
            <main>
                {{{ content }}}
            </main>

            <nav class="nav-wrapper" aria-label="Page navigation">
                {{#if previous}}
                    <a rel="prev" href="{{ path_to_root }}{{previous.link}}" class="mobile-nav-chapters previous" title="Previous chapter" aria-label="Previous chapter" aria-keyshortcuts="Left">
                        {{#if (eq ../text_direction "rtl")}}
                        {{fa "solid" "angle-right"}}
                        {{else}}
                        {{fa "solid" "angle-left"}}
                        {{/if}}
                    </a>
                {{/if}}

                {{#if next}}
                    <a rel="next prefetch" href="{{ path_to_root }}{{next.link}}" class="mobile-nav-chapters next" title="Next chapter" aria-label="Next chapter" aria-keyshortcuts="Right">
                        {{#if (eq ../text_direction "rtl")}}
                        {{fa "solid" "angle-left"}}
                        {{else}}
                        {{fa "solid" "angle-right"}}
                        {{/if}}
                    </a>
                {{/if}}

                <div style="clear: both"></div>
            </nav>
        </div>
    </div>

    <nav class="nav-wide-wrapper" aria-label="Page navigation">
        {{#if previous}}
            <a rel="prev" href="{{ path_to_root }}{{previous.link}}" class="nav-chapters previous" title="Previous chapter" aria-label="Previous chapter" aria-keyshortcuts="Left">
                {{#if (eq ../text_direction "rtl")}}
                {{fa "solid" "angle-right"}}
                {{else}}
                {{fa "solid" "angle-left"}}
                {{/if}}
            </a>
        {{/if}}

        {{#if next}}
            <a rel="next prefetch" href="{{ path_to_root }}{{next.link}}" class="nav-chapters next" title="Next chapter" aria-label="Next chapter" aria-keyshortcuts="Right">
                {{#if (eq text_direction "rtl")}}
                {{fa "solid" "angle-left"}}
                {{else}}
                {{fa "solid" "angle-right"}}
                {{/if}}
            </a>
        {{/if}}
    </nav>
</div>

{{#if live_reload_endpoint}}
{{!-- Livereload script (if served using the cli tool) --}}
<script>
    const wsAddress = "{{{live_reload_endpoint}}}";
    const socket = new WebSocket(wsAddress);
    socket.onmessage = function (event) {
        if (event.data === "reload") socket.close();
    };
    window.onbeforeunload = function() { socket.close(); }
</script>
{{/if}}

{{#if google_analytics}}
{{!-- Google Analytics Tag --}}
<script>
    var localAddrs = ["localhost", "127.0.0.1", ""];
    if ((!locationProtocol.startsWith('http') || localAddrs.indexOf(window.location.hostname) === -1)) {
        (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
        (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
        m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
        })(window,document,'script','https://www.google-analytics.com/analytics.js','ga');
        ga('create', '{{google_analytics}}', 'auto');
        ga('send', 'pageview');
    }
</script>
{{/if}}

{{#if playground_line_numbers}}
<script>
    window.playground_line_numbers = true;
</script>
{{/if}}

{{#if playground_copyable}}
<script>
    window.playground_copyable = true;
</script>
{{/if}}

{{#if playground_js}}
<script src="{{ path_to_root }}ace.js"></script>
<script src="{{ path_to_root }}editor.js"></script>
<script src="{{ path_to_root }}mode-rust.js"></script>
<script src="{{ path_to_root }}theme-dawn.js"></script>
<script src="{{ path_to_root }}theme-tomorrow_night.js"></script>
{{/if}}

{{#if search_js}}
<script src="{{ path_to_root }}elasticlunr.min.js"></script>
<script src="{{ path_to_root }}mark.min.js"></script>
<script src="{{ path_to_root }}searcher.js"></script>
{{/if}}

<script src="{{ path_to_root }}clipboard.min.js"></script>
<script src="{{ path_to_root }}highlight.js"></script>
<script src="{{ path_to_root }}book.js"></script>

{{!-- Liara admonition decorator: turns labeled blockquotes into colored callouts --}}
<script defer src="{{ path_to_root }}docs-shared/mdbook/additionals/js/admonitions.js"></script>

{{!-- Custom JS scripts --}}
{{#each additional_js}}
<script src="{{ ../path_to_root }}{{this}}"></script>
{{/each}}

</div>
</body>
</html>