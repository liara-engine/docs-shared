{
  "$schema": "https://liara-engine.github.io/liara/schemas/documentation-module.schema.json",
  "metadata": {
    "name": "Liara Docs-Shared Documentation",
    "description": "Documentation for the shared resources used across all Liara Engine documentation modules."
  },

  "resources": {
    "unspecified": {
      "README": "README.md",
      "Doxygen": {
        "path": "doxygen/README.md",
        "copy-name": "Doxygen.md"
      },
        "mdBook": {
          "path": "mdbook/README.md",
          "copy-name": "mdBook.md"
        }
    }
  }
}
