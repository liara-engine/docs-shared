---
/**
 * Liara Engine — the site title, with the module and version switchers
 * beside it.
 *
 * Placed inside Starlight's own header by overriding `SiteTitle` rather than
 * `Header`. Overriding the header would mean reimplementing search, the theme
 * toggle and the mobile menu, or fighting a fixed header height to fit a
 * second bar underneath — which is the shape of problem this whole migration
 * exists to leave behind. `SiteTitle` is a slot Starlight expects to be
 * replaced, so the switchers sit in supported territory.
 *
 * The switchers themselves are in ModuleSwitchers.astro, because the mobile
 * menu needs the same pair — see MobileMenuFooter.astro.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro';
import ModuleSwitchers from './ModuleSwitchers.astro';
---

<div class="liara-title">
    <div class="liara-title__name">
        <Default {...Astro.props}><slot /></Default>
    </div>

    <ModuleSwitchers variant="header" />
</div>

<style>
    .liara-title {
        display: flex;
        align-items: center;
        gap: var(--liara-space-3, 0.75rem);
        min-width: 0;
    }

    /* The one thing here that is allowed to lose the fight for width, which
       is the point: Starlight's header column is finite, and it used to be
       the switchers that gave way — a version number cut in half tells the
       reader nothing, while a shortened title still links home. */
    .liara-title__name {
        display: flex;
        min-width: 0;
        flex: 0 1 auto;
        overflow: hidden;
    }

    .liara-title__name :global(.site-title > span) {
        text-overflow: ellipsis;
    }
</style>
