{
  "$schema": "https://liara-engine.github.io/liara/schemas/documentation-module.schema.json",
  "metadata": {
    "name": "Doxygen Custom Theme",
    "description": "A custom theme for Doxygen documentation, not deployed itself but used by each `Doxyfile` to generate the actual documentation for each module."
  },

  "resources": {
    "favicon-ico": "docs-shared/assets/favicon.ico",
    "favicon-svg": "docs-shared/assets/logo.svg"
  },

  "replacements": {
    "{{{NAVBAR}}}": {
      "is-file": true,
      "value": "docs-shared/navbar/navbar.html",
      "only-in-files": ["header.html"]
    },
    "{{{LOGO}}}": {
      "is-file": false,
      "value": "$relpath^../favicon.svg",
      "only-in-files": ["header.html"]
    }
  }
}