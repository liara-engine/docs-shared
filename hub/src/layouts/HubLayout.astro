---
/**
 * Liara Engine — hub page shell.
 */
import '@liara/starlight-preset/styles/fonts.css';
import '@liara/starlight-preset/styles/tokens.css';
import '@liara/starlight-preset/styles/hub.css';
import ThemeSelect from '@liara/starlight-preset/components/ThemeSelect.astro';
import AccessibilityToggle from '@liara/starlight-preset/components/AccessibilityToggle.astro';

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFFAFC" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <script is:inline>
        (function () {
            try {
                var stored = localStorage.getItem('starlight-theme');
                var theme = stored === 'light' || stored === 'dark'
                    ? stored
                    : (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
                document.documentElement.dataset.theme = theme;
            } catch { /* localStorage unavailable — falls back to CSS's own light default */ }
            try {
                if (localStorage.getItem('liara-a11y-dyslexia') === 'true') {
                    document.documentElement.setAttribute('data-liara-a11y-dyslexia', 'true');
                }
            } catch { /* localStorage unavailable — falls back to the default fonts */ }
        })();
    </script>
</head>
<body>
    <nav class="liara-navbar" aria-label="Documentation navigation">
        <div class="liara-navbar__inner">
            <a class="liara-navbar__brand" href="/" aria-label="Liara Engine home">
                <img class="liara-navbar__logo" src="/favicon.svg" alt="" aria-hidden="true" width="24" height="24" />
                <span class="liara-navbar__brand-name">Liara Engine</span>
            </a>

            <div class="liara-navbar__spacer"></div>

            <div class="liara-navbar__actions">
                <ThemeSelect />
                <AccessibilityToggle />
                <a class="liara-navbar__action" href="https://github.com/liara-engine" target="_blank" rel="noopener" aria-label="View on GitHub" title="View on GitHub">
                    <svg class="liara-navbar__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85V21c0 .27.16.58.67.48A10 10 0 0 0 22 12 10 10 0 0 0 12 2z"/></svg>
                </a>
            </div>
        </div>
    </nav>

    <slot />
</body>
</html>
