---
import HubLayout from '../layouts/HubLayout.astro';
import { MODULE_CARDS, EXTRA_CARDS, PLANNED_CARDS, ABI_REFERENCE_REPO } from '../data/modules.js';
---

<HubLayout
    title="Liara Engine — Documentation"
    description="Liara Engine is a modern 3D game engine, built from scratch in C++ with Vulkan, as a personal learning project. Modular, cross-platform, and openly developed."
>
<main class="hub">

    <!-- ============================================================
         Hero
         ============================================================ -->
    <section class="hub-hero">
        <div class="hub-hero__decor" aria-hidden="true">
            <div class="hub-hero__blob hub-hero__blob--pink"></div>
            <div class="hub-hero__blob hub-hero__blob--lavender"></div>
        </div>

        <div class="hub-hero__inner">
            <p class="hub-hero__eyebrow">
                <span class="hub-hero__status-dot" aria-hidden="true"></span>
                <span>Phase 0 — Bootstrap</span>
            </p>

            <h1 class="hub-hero__title">
                Liara <span class="hub-hero__title-accent">Engine</span>
            </h1>

            <p class="hub-hero__tagline">
                A modern 3D game engine, built from scratch in C++ with Vulkan,
                as a personal learning project. Modular by construction,
                cross-platform, and openly developed.
            </p>

            <div class="hub-hero__cta">
                <a class="hub-button hub-button--primary" href="/user/dev/">
                    <span>Read the user guide</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                </a>
                <a class="hub-button hub-button--secondary" href="https://github.com/liara-engine" target="_blank" rel="noopener">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.09.66-.22.66-.48v-1.7c-2.78.6-3.37-1.34-3.37-1.34-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.02a9.5 9.5 0 0 1 5 0c1.91-1.29 2.75-1.02 2.75-1.02.55 1.38.2 2.4.1 2.65.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85V21c0 .27.16.58.67.48A10 10 0 0 0 22 12 10 10 0 0 0 12 2z"/></svg>
                    <span>View on GitHub</span>
                </a>
            </div>

            <ul class="hub-hero__meta">
                <li><span class="hub-hero__meta-label">License</span> <span>MIT</span></li>
                <li><span class="hub-hero__meta-label">Language</span> <span>C++20 / C ABI</span></li>
                <li><span class="hub-hero__meta-label">Graphics</span> <span>Vulkan 1.3</span></li>
                <li><span class="hub-hero__meta-label">Platforms</span> <span>Linux, Windows</span></li>
            </ul>
        </div>
    </section>

    <!-- ============================================================
         Modules grid
         ============================================================ -->
    <section class="hub-section">
        <header class="hub-section__header">
            <h2 class="hub-section__title">Modules</h2>
            <p class="hub-section__subtitle">
                Liara is composed of independently versioned modules
                connected through a stable C ABI. Each has its own
                repository and its own API documentation.
            </p>
        </header>

        <div class="hub-modules">
            {EXTRA_CARDS.map((card) => (
                <a class="hub-card hub-card--module" href={card.href}>
                    <div class="hub-card__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={card.icon} />
                    </div>
                    <div class="hub-card__body">
                        <h3 class="hub-card__title">{card.title}</h3>
                        <p class="hub-card__description">{card.description}</p>
                    </div>
                </a>
            ))}

            {MODULE_CARDS.map((card) => (
                <a class="hub-card hub-card--module" href={card.href} data-liara-module-link data-liara-repo={card.repo}>
                    <div class="hub-card__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={card.icon} />
                    </div>
                    <div class="hub-card__body">
                        <h3 class="hub-card__title">{card.title}</h3>
                        <p class="hub-card__description">{card.description}</p>
                        <p class="hub-card__meta" data-liara-card-version data-liara-repo={card.repo}>{card.version}</p>
                    </div>
                </a>
            ))}

            {PLANNED_CARDS.map((card) => (
                <div class="hub-card hub-card--module hub-card--planned" aria-disabled="true">
                    <div class="hub-card__icon">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={card.icon} />
                    </div>
                    <div class="hub-card__body">
                        <h3 class="hub-card__title">{card.title}</h3>
                        <p class="hub-card__description">{card.description}</p>
                        <p class="hub-card__meta">Planned</p>
                    </div>
                </div>
            ))}
        </div>
    </section>

    <!-- ============================================================
         Resources
         ============================================================ -->
    <section class="hub-section">
        <header class="hub-section__header">
            <h2 class="hub-section__title">Resources</h2>
            <p class="hub-section__subtitle">
                Reference documents that govern how the project is built and
                evolves. These live in the meta repository.
            </p>
        </header>

        <div class="hub-resources">
            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/ARCHITECTURE" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Architecture</h3>
                <p class="hub-card__description">The philosophy and principles behind every design decision.</p>
            </a>

            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/MODULES" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Modules</h3>
                <p class="hub-card__description">Concrete decomposition: what each repository contains.</p>
            </a>

            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/ROADMAP" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Roadmap</h3>
                <p class="hub-card__description">Phase 0 through v2.0, with milestones and definitions of done.</p>
            </a>

            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/CONTRIBUTING" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Contributing</h3>
                <p class="hub-card__description">Workflow, branches, commits, reviews. The daily mechanics.</p>
            </a>

            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/CODE_STYLE" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Code style</h3>
                <p class="hub-card__description">C++ conventions, clang-format, clang-tidy, anti-patterns.</p>
            </a>

            <a class="hub-card hub-card--resource" href="https://liara-engine.liara-engine-documentation.workers.dev/liara/dev/book/BOOTSTRAP" target="_blank" rel="noopener">
                <h3 class="hub-card__title">Bootstrap</h3>
                <p class="hub-card__description">Setting up Arch or Windows for Liara development.</p>
            </a>
        </div>
    </section>

</main>

<footer class="hub-footer">
    <div class="hub-footer__inner">
        <p class="hub-footer__line">
            Liara Engine &middot;
            <a href="https://github.com/liara-engine" target="_blank" rel="noopener">GitHub organization</a> &middot;
            <a href="https://github.com/liara-engine/liara/blob/main/LICENSE" target="_blank" rel="noopener">MIT license</a>
        </p>
        <p class="hub-footer__small">
            A personal learning project, made open in case it is useful to anyone else.
        </p>
    </div>
</footer>
</HubLayout>

<script>
    /**
     * Corrects the build-time module cards against the live registry.
     */
    async function reconcile() {
        const response = await fetch('/registry-index.json', { cache: 'no-cache' });
        if (!response.ok) return;
        const index = await response.json();
        if (!Array.isArray(index?.modules)) return;

        for (const badge of document.querySelectorAll('[data-liara-card-version]')) {
            const module = index.modules.find((m) => m.repo === badge.dataset.liaraRepo);
            const latest = module?.latest;
            if (!latest) continue;

            badge.textContent = latest;
            const link = badge.closest('[data-liara-module-link]');
            if (link) link.href = `/${badge.dataset.liaraRepo}/${latest}/`;
        }

        const list = document.querySelector('[data-liara-versions-list]');
        const repo = list?.dataset.liaraAbiRepo;
        if (!list || !repo) return;
        const module = index.modules.find((m) => m.repo === repo);
        if (!module?.order?.length) return;

        list.replaceChildren(...module.order.map((label) => {
            const a = document.createElement('a');
            a.href = `/${repo}/${label}/`;
            a.className = label === 'dev' ? 'hub-version hub-version--current'
                : label === module.latest ? 'hub-version hub-version--latest' : 'hub-version';

            const value = document.createElement('span');
            value.className = 'hub-version__label';
            value.textContent = label;
            a.append(value);

            const note = label === 'dev' ? 'Current development' : label === module.latest ? 'Latest release' : '';
            if (note) {
                const noteEl = document.createElement('span');
                noteEl.className = 'hub-version__note';
                noteEl.textContent = note;
                a.append(noteEl);
            }
            return a;
        }));
    }

    reconcile().catch(() => { /* keep the build-time markup */ });
</script>
