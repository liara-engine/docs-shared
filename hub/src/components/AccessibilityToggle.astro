---
/**
 * Dyslexia-friendly mode toggle — ported from the retired shared navbar's
 * `data-liara-a11y-toggle` button. `tokens.css` already carries the whole
 * `[data-liara-a11y-dyslexia='true']` ruleset (OpenDyslexic, relaxed
 * leading and letter-spacing); this is the only piece that was missing
 * once the old navbar went with it.
 */
const STORAGE_KEY = 'liara-a11y-dyslexia';
---

<button type="button" class="liara-navbar__action liara-navbar__action--text" id="hub-a11y-toggle"
        aria-label="Toggle dyslexia-friendly mode" aria-pressed="false" title="Dyslexia-friendly mode">
    <span aria-hidden="true">Aa</span>
</button>

<script define:vars={{ STORAGE_KEY }}>
    const button = document.getElementById('hub-a11y-toggle');

    function apply(enabled) {
        if (enabled) {
            document.documentElement.setAttribute('data-liara-a11y-dyslexia', 'true');
        } else {
            document.documentElement.removeAttribute('data-liara-a11y-dyslexia');
        }
        button?.setAttribute('aria-pressed', String(enabled));
    }

    let enabled = false;
    try {
        enabled = localStorage.getItem(STORAGE_KEY) === 'true';
    } catch { /* localStorage unavailable — starts off, still toggleable for this load */ }
    apply(enabled);

    button?.addEventListener('click', () => {
        enabled = !enabled;
        apply(enabled);
        try {
            localStorage.setItem(STORAGE_KEY, String(enabled));
        } catch { /* the choice still applies for this load */ }
    });
</script>

<style>
    .liara-navbar__action--text {
        font-weight: var(--liara-weight-medium);
        font-size: var(--liara-text-base);
        letter-spacing: -0.02em;
    }
</style>
