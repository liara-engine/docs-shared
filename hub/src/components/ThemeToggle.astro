---
/**
 * Theme cycle button: auto -> light -> dark -> auto.
 *
 * A single button rather than Starlight's own three-item `<select>`
 * (`@astrojs/starlight/components/ThemeSelect.astro`) — closer to how the
 * old shared navbar did it, and a better fit for a compact action row. The
 * storage contract is identical to Starlight's own: `localStorage['starlight-theme']`
 * holds `'auto'`, `'light'` or `'dark'` (empty string for auto), and
 * `data-theme` on `<html>` is always the *resolved* value — 'auto' never
 * appears there, only on this button, so its own icon can tell the three
 * states apart. That's what makes a preference set here carry into a
 * module's docs and back: same key, same values, same resolution.
 */
---

<button type="button" class="liara-navbar__action" id="hub-theme-toggle" aria-label="Cycle color theme" title="Cycle color theme">
    <svg class="liara-navbar__icon liara-theme-icon--auto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="13" rx="2"/><path d="M8 21h8M12 18v3"/>
    </svg>
    <svg class="liara-navbar__icon liara-theme-icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/>
    </svg>
    <svg class="liara-navbar__icon liara-theme-icon--dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
    </svg>
</button>

<script>
    const STORAGE_KEY = 'starlight-theme';
    const ORDER = ['auto', 'light', 'dark'];
    const button = document.getElementById('hub-theme-toggle');

    const parseTheme = (theme: unknown) => (ORDER as string[]).includes(theme as string) ? (theme as string) : 'auto';
    const loadTheme = () => {
        try {
            return parseTheme(localStorage.getItem(STORAGE_KEY));
        } catch {
            return 'auto';
        }
    };
    const storeTheme = (theme: string) => {
        try {
            localStorage.setItem(STORAGE_KEY, theme === 'auto' ? '' : theme);
        } catch { /* localStorage unavailable — the choice still applies for this load */ }
    };
    const preferredScheme = () => (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');

    function apply(theme: string) {
        document.documentElement.dataset.theme = theme === 'auto' ? preferredScheme() : theme;
        button?.setAttribute('data-theme-choice', theme);
    }

    apply(loadTheme());

    button?.addEventListener('click', () => {
        const next = ORDER[(ORDER.indexOf(loadTheme()) + 1) % ORDER.length]!;
        storeTheme(next);
        apply(next);
    });

    // React to a system-preference change while "auto" is selected, the
    // same event Starlight's own ThemeSelect listens for.
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', () => {
        if (loadTheme() === 'auto') apply('auto');
    });
</script>

<style>
    .liara-theme-icon--light,
    .liara-theme-icon--dark {
        display: none;
    }

    #hub-theme-toggle[data-theme-choice="light"] .liara-theme-icon--auto,
    #hub-theme-toggle[data-theme-choice="light"] .liara-theme-icon--dark {
        display: none;
    }
    #hub-theme-toggle[data-theme-choice="light"] .liara-theme-icon--light {
        display: block;
    }

    #hub-theme-toggle[data-theme-choice="dark"] .liara-theme-icon--auto,
    #hub-theme-toggle[data-theme-choice="dark"] .liara-theme-icon--light {
        display: none;
    }
    #hub-theme-toggle[data-theme-choice="dark"] .liara-theme-icon--dark {
        display: block;
    }
</style>
