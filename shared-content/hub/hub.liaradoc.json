{
  "$schema": "https://liara-engine.github.io/liara/schemas/documentation-module.schema.json",
  "metadata": {
    "name": "Liara Engine Documentation Hub Shared Content",
    "description": "Liara Engine Documentation Hub Shared Content"
  },

  "resources": {
    "unspecified": {
      "navbar": "docs-shared/shared-content/navbar/navbar.html",
      "shared-navbar": "docs-shared/shared-content/navbar/shared-navbar.js"
    }
  },

  "replacements": {
    "{{{LOGO}}}": {
      "is-file": false,
      "value": "/shared-content/assets/logo.svg",
      "only-in-files": ["navbar.html"]
    },
    "{{{MODULE}}}": {
      "is-file": false,
      "value": "hub",
      "only-in-files": ["shared-navbar.js"]
    }
  }
}